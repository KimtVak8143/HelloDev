{
  "name": "hellodev-tracker",
  "displayName": "HelloDev Tracker",
  "version": "1.0.0",
  "description": "HelloDev - Agentic Sprint Tracker powered by Notion MCP",
  "publisher": "hellodev",
  "repository": {
    "type": "git",
    "url": "https://github.com/KimtVak8143/HelloDev.git"
  },
  "homepage": "https://github.com/KimtVak8143/HelloDev",
  "bugs": {
    "url": "https://github.com/KimtVak8143/HelloDev/issues"
  },
  "main": "src/extension.js",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hellodev.startTask",
    "onCommand:hellodev.completeTask",
    "onCommand:hellodev.viewStatus",
    "onCommand:hellodev.myTasks",
    "onCommand:hellodev.generateStandup",
    "onCommand:hellodev.installGitHook",
    "onCommand:hellodev.openOnboarding",
    "onCommand:hellodev.openonboarding"
  ],
  "contributes": {
    "commands": [
      {
        "command": "hellodev.startTask",
        "title": "HelloDev: Start Task"
      },
      {
        "command": "hellodev.completeTask",
        "title": "HelloDev: Complete Task"
      },
      {
        "command": "hellodev.viewStatus",
        "title": "HelloDev: View Status"
      },
      {
        "command": "hellodev.myTasks",
        "title": "HelloDev: My Tasks"
      },
      {
        "command": "hellodev.generateStandup",
        "title": "HelloDev: Generate Standup"
      },
      {
        "command": "hellodev.installGitHook",
        "title": "HelloDev: Install Git Hook"
      },
      {
        "command": "hellodev.openOnboarding",
        "title": "HelloDev: Open Onboarding"
      }
    ]
  },
  "bin": {
    "hellodev": "./src/cli/commands.js"
  },
  "scripts": {
    "start": "node src/extension.js",
    "test-connection": "node test-connection.js",
    "build": "npm run verify",
    "dev": "node src/extension.js",
    "mcp": "node src/mcp/index.js",
    "all": "concurrently \"npm run dev\" \"npm run mcp\"",
    "package:vsix": "vsce package",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/ openapi.yaml README.md",
    "check-format": "prettier --check src/ openapi.yaml README.md",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "npm run lint && npm run check-format && npm run test-connection",
    "pre-commit": "npm run lint && npm run check-format"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@notionhq/client": "^2.2.15",
    "axios": "^1.13.6",
    "chokidar": "^5.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "simple-git": "^3.32.3",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.8.1",
    "vsce": "^2.15.0"
  }
}
